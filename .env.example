# Скопируйте: cp .env.example .env

TELEGRAM_BOT_TOKEN=
BOT_LINK=https://t.me/your_bot?start=ref
TEST_CHAT_ID=
ADMIN_CHAT_ID=
START_GIF_URL=

YAM_TOKEN=

GRAMADS_KEY=
GRAMADS_ON=False

# --- Сервер данных (docker-compose.prod.data.yml) ---
POSTGRES_DB=mus_db
POSTGRES_USER=admin
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_PORT=5432

# --- Сервер бота (docker-compose.prod.bot.yml) ---
# IP или hostname сервера данных (НЕ localhost, если БД на другом VPS):
POSTGRES_HOST=db
REDIS_URL=redis://redis:6379/1

# Для split-инфраструктуры на сервере бота, например:
# POSTGRES_HOST=203.0.113.10
# REDIS_URL=redis://203.0.113.10:6379/1

DEBUG=False
