FROM python:3.12-slim

WORKDIR /app

# 1. Системные утилиты для wait-скриптов
RUN apt-get update && apt-get install -y \
    postgresql-client \
    && rm -rf /var/lib/apt/lists/*

# 2. Poetry (официальный curl-инсталлер с python-poetry.org отдаёт HTML, не скрипт)
ENV POETRY_VIRTUALENVS_CREATE=false
RUN pip install --no-cache-dir poetry

# 3. Копируем файлы зависимостей отдельно (для кэширования слоев Docker)
COPY pyproject.toml poetry.lock* ./

# 4. Устанавливаем ВСЕ зависимости, включая dev (pytest)
RUN poetry install --no-root --no-interaction --no-ansi

# 5. Копируем остальной код проекта
COPY . .

# 6. Даем права на запуск скриптов
RUN chmod +x /app/scripts/wait-for-services.sh /app/scripts/run-tests.sh